# New v2 resources only. Never point this at the v1 database.
DATABASE_URL=postgresql://study_vault_runtime:password@ep-example.eu-central-1.aws.neon.tech/study_vault_v2?sslmode=require
DATABASE_ADMIN_URL=postgresql://owner:password@ep-example.eu-central-1.aws.neon.tech/study_vault_v2?sslmode=require
BETTER_AUTH_URL=https://gotfoth.vercel.app
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Bootstrap operator. Additional operators are rows in the superusers table.
SUPERUSER_EMAIL=alasdair.anderson@gmail.com
BLOB_READ_WRITE_TOKEN=
OPENAI_API_KEY=
# Models and EUR provider prices are explicitly configured through the admin rate card.
TOKEN_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false
MERCHANT_REFUND_POLICY_URL=
CRON_SECRET=
# Welcome emails sent when an invitation link is copied. Verify the from-address domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=GotFoth <hello@example.com>
# Atomic operator usage guard, in EUR micro-units. Configure a tested rate card in admin.
GLOBAL_AI_BUDGET_MICROS=0
# Operator maintenance only; do not put owner or backup keys in the web deployment.
BACKUP_ENCRYPTION_KEY=
BACKUP_BLOB_READ_WRITE_TOKEN=
RESTORE_TEST_DATABASE_URL=
