# Paper bank only. Never point this at the Study Vault database.
# Admin URL is used once, to CREATE DATABASE paper_bank on the existing Neon project.
PAPER_BANK_ADMIN_URL=postgresql://owner:password@ep-example.eu-central-1.aws.neon.tech/paper_bank?sslmode=require
PAPER_BANK_URL=postgresql://paper_bank_runtime:password@ep-example.eu-central-1.aws.neon.tech/paper_bank?sslmode=require

# Operator passphrase for the review app. At least 12 characters.
BANK_PASSPHRASE=
# HMAC key for the operator session cookie. At least 32 characters.
BANK_SESSION_SECRET=
# Bearer token Study Vault can send as Authorization: Bearer <token>. At least 32 characters.
BANK_READ_TOKEN=
